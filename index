<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>🌕 2026 추석 선물 안내 🎁</title>
  <!-- Tailwind CSS & FontAwesome Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/projectnoonnu/noonfonts_two@1.0/NanumSquareRound.css">

  <style>
    body {
      font-family: 'NanumSquareRound', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #fdfbf7; /* 은은하고 따뜻한 크림/한지 배경 톤 */
      color: #334155;
      -webkit-tap-highlight-color: transparent;
    }

    /* 추석 분위기 카드 그래픽 효과 */
    .gift-card {
      transition: all 0.25s ease;
      border: 2px solid #f3e8ff;
    }
    .gift-card.selected {
      border-color: #a855f7;
      background-color: #faf5ff;
      box-shadow: 0 8px 20px rgba(168, 85, 247, 0.15);
      transform: translateY(-2px);
    }

    .moon-bg {
      background: radial-gradient(circle at 50% 30%, #fef08a 0%, #fdfbf7 70%);
    }
  </style>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'chuseok-purple': '#7e22ce',
            'chuseok-gold': '#eab308',
            'chuseok-bg': '#fdfbf7',
          }
        }
      }
    }
  </script>
</head>
<body class="max-w-md mx-auto p-4 pb-12">

  <!-- Header Section (추석 한가위 느낌) -->
