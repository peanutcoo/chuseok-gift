      🌕 2026 한가위 풍성한 명절 🎁
    </div>
    <h1 class="text-2xl font-extrabold text-slate-800 mb-1">
      2026 추석 선물 안내
    </h1>
    <p class="text-xs text-slate-500">원하시는 명절 선물을 선택 후 제출해 주세요!</p>
  </header>

  <!-- Gift Options List -->
  <section class="space-y-4 mb-8" id="gift-list">
    
    <!-- 1. 한우 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('1. 한우 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-amber-50 flex items-center justify-center text-3xl border border-amber-100 flex-shrink-0">
          🥩
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">1. 한우 세트</h3>
            <span class="text-xs bg-purple-50 text-purple-700 font-bold px-2 py-0.5 rounded-full border border-purple-100">명품 한우</span>
          </div>
          <p class="text-xs text-slate-500 mb-2">풍성하고 다채로운 구성의 명품 한우 선물 세트</p>
          <a href="https://kko.to/b4rgGbgNSS" target="_blank" onclick="event.stopPropagation();" 
             class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 hover:underline">
            <i class="fas fa-external-link-alt text-[10px]"></i> 카카오 선물함 상세보기
          </a>
        </div>
      </div>
    </div>

    <!-- 2. 과일 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('2. 과일 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-orange-50 flex items-center justify-center text-3xl border border-orange-100 flex-shrink-0">
          🍎
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">2. 과일 세트</h3>
            <span class="text-xs bg-orange-50 text-orange-700 font-bold px-2 py-0.5 rounded-full border border-orange-100">신선 과일</span>
          </div>
          <p class="text-xs text-slate-500 mb-2">달콤하고 싱싱한 과일 모음 세트</p>
          <a href="https://kko.to/-3VC7VkB58" target="_blank" onclick="event.stopPropagation();" 
             class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 hover:underline">
            <i class="fas fa-external-link-alt text-[10px]"></i> 카카오 선물함 상세보기
          </a>
        </div>
      </div>
    </div>

    <!-- 3. 육포 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('3. 육포 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-red-50 flex items-center justify-center text-3xl border border-red-100 flex-shrink-0">
          🥓
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">3. 육포 세트</h3>
            <span class="text-xs bg-red-50 text-red-700 font-bold px-2 py-0.5 rounded-full border border-red-100">고급 미식</span>
          </div>
          <p class="text-xs text-slate-500 mb-2">쫄깃하고 풍미 가득한 프리미엄 육포 세트</p>
          <a href="https://kko.to/cDrYgCCc9C" target="_blank" onclick="event.stopPropagation();" 
             class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 hover:underline">
            <i class="fas fa-external-link-alt text-[10px]"></i> 카카오 선물함 상세보기
          </a>
        </div>
      </div>
    </div>

    <!-- 4. 정관장 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('4. 정관장 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-emerald-50 flex items-center justify-center text-3xl border border-emerald-100 flex-shrink-0">
          🌿
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">4. 정관장 세트</h3>
            <span class="text-xs bg-emerald-50 text-emerald-700 font-bold px-2 py-0.5 rounded-full border border-emerald-100">건강 케어</span>
          </div>
          <p class="text-xs text-slate-500 mb-2">활력과 건강을 선물하는 정관장 선물 세트</p>
          <a href="https://kko.to/auE7AqBwQP" target="_blank" onclick="event.stopPropagation();" 
             class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 hover:underline">
            <i class="fas fa-external-link-alt text-[10px]"></i> 카카오 선물함 상세보기
          </a>
        </div>
      </div>
    </div>

    <!-- 5. 곱창김 + 스팸 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('5. 곱창김 + 스팸 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-blue-50 flex items-center justify-center text-3xl border border-blue-100 flex-shrink-0">
          🍱
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">5. 곱창김 + 스팸 세트</h3>
            <span class="text-xs bg-blue-50 text-blue-700 font-bold px-2 py-0.5 rounded-full border border-blue-100">실속 구성</span>
          </div>
          <p class="text-xs text-slate-500 mb-1.5">바삭한 곱창김과 밥도둑 스팸의 찰떡 조합</p>
          <div class="flex gap-2 text-[11px]">
            <a href="https://kko.to/1cgNCS3QDH" target="_blank" onclick="event.stopPropagation();" class="text-amber-700 font-bold hover:underline">
              <i class="fas fa-external-link-alt text-[10px]"></i> 곱창김 보기
            </a>
            <span class="text-slate-300">|</span>
            <a href="https://kko.to/00bD6eaITX" target="_blank" onclick="event.stopPropagation();" class="text-amber-700 font-bold hover:underline">
              <i class="fas fa-external-link-alt text-[10px]"></i> 스팸 보기
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. 올리브유 + 정관장 -->
    <div class="gift-card bg-white p-4 rounded-2xl shadow-sm relative cursor-pointer" onclick="selectGift('6. 올리브유 + 정관장 세트')">
      <div class="flex gap-3.5 items-center">
        <div class="w-16 h-16 rounded-xl bg-yellow-50 flex items-center justify-center text-3xl border border-yellow-100 flex-shrink-0">
          🫒
        </div>
        <div class="flex-1 min-w-0">
          <div class="flex justify-between items-start">
            <h3 class="font-extrabold text-slate-800 text-base mb-0.5">6. 올리브유 + 정관장 세트</h3>
            <span class="text-xs bg-yellow-50 text-yellow-700 font-bold px-2 py-0.5 rounded-full border border-yellow-100">웰빙 컬렉션</span>
          </div>
          <p class="text-xs text-slate-500 mb-1.5">프리미엄 올리브유와 정관장 건강 선물 컬렉션</p>
          <div class="flex gap-2 text-[11px]">
            <a href="https://kko.to/S6WfCpscjY" target="_blank" onclick="event.stopPropagation();" class="text-amber-700 font-bold hover:underline">
              <i class="fas fa-external-link-alt text-[10px]"></i> 올리브유 보기
            </a>
            <span class="text-slate-300">|</span>
            <a href="https://kko.to/brLbi7DCSb" target="_blank" onclick="event.stopPropagation();" class="text-amber-700 font-bold hover:underline">
              <i class="fas fa-external-link-alt text-[10px]"></i> 정관장 보기
            </a>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Submit Form Section -->
  <section class="bg-white p-6 rounded-3xl shadow-md border-2 border-amber-100 space-y-4">
    <h2 class="text-lg font-extrabold text-slate-800 flex items-center gap-2">
      <i class="fas fa-paper-plane text-purple-600"></i>
      선물 투표 및 신청하기
    </h2>

    <form id="vote-form" class="space-y-4">
      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700">성함 (이름)</label>
        <input type="text" id="user-name" placeholder="예: 홍길동" required
               class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-purple-500 focus:outline-none text-sm text-slate-800 font-bold">
      </div>

      <div class="space-y-1.5">
        <label class="text-xs font-bold text-slate-700">선택한 희망 선물</label>
        <input type="text" id="selected-gift" placeholder="위 목록에서 선물을 클릭해 주세요" readonly required
               class="w-full p-3.5 bg-purple-50/60 border border-purple-200 rounded-2xl text-purple-900 font-extrabold text-sm focus:outline-none cursor-pointer">
      </div>

      <button type="submit" class="w-full p-4 bg-purple-600 hover:bg-purple-700 text-white rounded-2xl font-bold text-base transition-all shadow-md active:scale-95 flex items-center justify-center gap-2 mt-2">
        <i class="fas fa-check-circle"></i>
        <span>투표 및 제출하기</span>
      </button>
    </form>
  </section>

  <script>
    // ⚠️ 구글 Apps Script Web App URL을 여기에 붙여넣으세요!
    const API_URL = "https://script.google.com/macros/s/AKfycbzxGGWRSnt6Nf1i2UbQUTd_8dwJ5fHOtlAUnqxg-y2LRkn8TmM-GDMY3VnEipauWZFU/exec";

    function selectGift(giftName) {
      document.getElementById('selected-gift').value = giftName;
      
      // 모든 카드의 선택 스타일 해제 후 클릭된 카드만 강조
      const cards = document.querySelectorAll('.gift-card');
      cards.forEach(card => card.classList.remove('selected'));
      
      event.currentTarget.classList.add('selected');
    }

    document.getElementById('vote-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const name = document.getElementById('user-name').value.trim();
      const gift = document.getElementById('selected-gift').value;

      if (!gift) {
        alert("선물 목록에서 희망하시는 선물을 먼저 클릭해 주세요!");
        return;
      }

      const submitBtn = e.target.querySelector('button');
      submitBtn.innerText = "제출 처리 중...";
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50');

      try {
        await fetch(API_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify({ name: name, item: gift })
        });

        alert(`🎉 ${name}님, [${gift}] 신청이 정상적으로 완료되었습니다!`);
        document.getElementById('vote-form').reset();
        
        // 카드 선택 해제
        document.querySelectorAll('.gift-card').forEach(card => card.classList.remove('selected'));
      } catch (err) {
        alert("오류가 발생했습니다. 다시 시도해주세요.");
      } finally {
        submitBtn.innerHTML = '<i class="fas fa-check-circle"></i><span>투표 및 제출하기</span>';
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50');
      }
    });
  </script>
</body>
</html>
